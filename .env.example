# ---------------------------------------------------------------------------
# Gemini. The only required credential.
# Run `make doctor` after setting this -- it prints the exact MODEL_* lines
# to paste back here, based on what your key can actually call.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=

MODEL_SCORE=gemini-flash-lite-latest
MODEL_TAILOR=gemini-flash-latest

# Free tier is ~15 RPM / 1500 RPD. These leave margin.
# Paid (Tier 1) projects can raise these to 60 / 5000.
GEMINI_RPM=12
GEMINI_RPD_BUDGET=1200

# Comma-separated. Stripped from every prompt before it leaves the process.
# On the free tier Google may train on prompts -- put your employer here.
PII_DENY_TERMS=

# ---------------------------------------------------------------------------
# Telegram (optional). Without it, the review queue prints to stdout.
# @BotFather -> /newbot for the token; @userinfobot for the chat id.
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------------
# Adzuna (optional). 1000 free calls/month. developer.adzuna.com
# Without it, ATS sources only.
# ---------------------------------------------------------------------------
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# ---------------------------------------------------------------------------
# Gmail (optional, read-only scope). This is how LinkedIn/Naukri alerts get in.
# See README step 4 -- download the OAuth desktop-app JSON to the path below.
# ---------------------------------------------------------------------------
GMAIL_CREDENTIALS_JSON=./data/gmail_credentials.json
GMAIL_TOKEN_JSON=./data/gmail_token.json

# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------
JOBPIPE_DB=./data/jobpipe.db

# Fetch full job descriptions for postings that arrive without one (email
# alerts, some aggregators). Public posting pages only, never behind a login.
JD_FETCH_ENABLED=true
JD_FETCH_MAX=25
