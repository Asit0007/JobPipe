# ---------------------------------------------------------------------------
# Gemini. The only required credential.
# Run `make doctor` after setting this -- it prints the exact MODEL_* lines
# to paste back here, based on what your key can actually call.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=

MODEL_SCORE=gemini-flash-lite-latest
MODEL_TAILOR=gemini-flash-latest

# Free tier is ~15 RPM / 1500 RPD. These leave margin.
# Paid (Tier 1) projects can raise these to 60 / 5000.
# Both measured, not guessed. RPM 12 produced sustained 429s on a long `score`
# run; 10 holds. The daily budget is per MODEL, and 1200 was fiction -- the free
# tier gives 500/day for gemini-flash-lite-latest and only 20/day for
# gemini-flash-latest, so `prepare` (2 calls per job) caps at ~10 jobs a day.
# Override one model with GEMINI_RPD_BUDGET_<model> if your key differs.
GEMINI_RPM=10
GEMINI_RPD_BUDGET=500

# Comma-separated. Stripped from every prompt before it leaves the process.
# On the free tier Google may train on prompts -- put your employer here.
PII_DENY_TERMS=

# ---------------------------------------------------------------------------
# Telegram (optional). Without it, the review queue prints to stdout.
# @BotFather -> /newbot for the token; @userinfobot for the chat id.
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------------
# Adzuna (optional). 1000 free calls/month. developer.adzuna.com
# Without it, ATS sources only.
# ---------------------------------------------------------------------------
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# ---------------------------------------------------------------------------
# Gmail, read-only. This is how LinkedIn/Naukri/Indeed/Glassdoor alerts get in:
# you set alerts on those sites, they mail you, we parse your own inbox.
#
# PREFERRED -- IMAP + App Password. Free, no expiry, no Cloud project.
#   1. Enable 2-Step Verification : https://myaccount.google.com/security
#   2. Create an App Password     : https://myaccount.google.com/apppasswords
#   3. Fill these in, then run: make gmail-imap-check PY=./.venv/bin/python
# ---------------------------------------------------------------------------
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
# GMAIL_IMAP_FOLDER=[Gmail]/All Mail      # set if your Gmail is localised

# A hand-maintained label beats the default sender list: you curate it, and the
# boards cannot break it by changing a subdomain. Gmail search syntax works
# as-is -- the IMAP backend passes it through X-GM-RAW.
# GMAIL_ALERT_QUERY=label:"Job Alerts" newer_than:7d

# DEPRECATED -- OAuth. `gmail.readonly` is a restricted scope, so an External
# app stuck in Testing has its refresh token expired every 7 days and a daily
# cron silently stops pulling alerts. Used only when GMAIL_APP_PASSWORD is empty.
GMAIL_CREDENTIALS_JSON=./data/gmail_credentials.json
GMAIL_TOKEN_JSON=./data/gmail_token.json

# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------
JOBPIPE_DB=./data/jobpipe.db

# Fetch full job descriptions for postings that arrive without one (email
# alerts, some aggregators). Public posting pages only, never behind a login.
JD_FETCH_ENABLED=true
JD_FETCH_MAX=25
